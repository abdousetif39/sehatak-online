rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth != null && userDoc != null && userDoc.data.role == 'admin';
    }
    
    function isReceptionistFor(doctorId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth != null && userDoc != null && userDoc.data.role == 'receptionist' && userDoc.data.doctorId == doctorId;
    }

    function isDoctor() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth != null && userDoc != null && userDoc.data.role == 'doctor';
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId || isAdmin();
      allow update: if request.auth.uid == userId || isAdmin() || (isDoctor() && request.auth.uid == resource.data.doctorId);
      allow delete: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth.uid == doctorId;
    }
    
    match /public_slots/{slotId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.doctorId == request.auth.uid) || isReceptionistFor(resource.data.doctorId);
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.doctorId == request.auth.uid) || isReceptionistFor(resource.data.doctorId);
      allow create: if true;
      allow update: if isAdmin() || (request.auth != null && resource.data.doctorId == request.auth.uid) || isReceptionistFor(resource.data.doctorId);
      allow delete: if isAdmin() || (request.auth != null && resource.data.doctorId == request.auth.uid) || isReceptionistFor(resource.data.doctorId);
    }

    match /supportConversations/{conversationId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.doctorId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.doctorId == request.auth.uid || isAdmin();
      allow update: if isAdmin() || (request.auth != null && resource.data.doctorId == request.auth.uid);
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isAdmin() || (request.auth != null && get(/databases/$(database)/documents/supportConversations/$(conversationId)).data.doctorId == request.auth.uid);
        allow create: if isAdmin() || (request.auth != null && get(/databases/$(database)/documents/supportConversations/$(conversationId)).data.doctorId == request.auth.uid);
        allow update: if isAdmin() || (request.auth != null && get(/databases/$(database)/documents/supportConversations/$(conversationId)).data.doctorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'deliveredAt', 'deletedForDoctor']));
        allow delete: if isAdmin();
      }
    }

    match /broadcastMessages/{broadcastId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /broadcastRecipients/{recipientId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.doctorId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && resource.data.doctorId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
